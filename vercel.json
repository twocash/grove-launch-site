{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "registrar.the-grove.ai" }
      ],
      "destination": "/registrar",
      "permanent": false
    },
    {
      "source": "/papers",
      "destination": "/alerts",
      "permanent": true
    },
    {
      "source": "/papers/:path*",
      "destination": "/alerts/:path*",
      "permanent": true
    },
    {
      "source": "/alerts/open-weights-wont-be-enough",
      "destination": "/alerts/sovereignty-is-all-you-need",
      "permanent": true
    },
    {
      "source": "/alerts/open-weights-wont-be-enough/:path*",
      "destination": "/alerts/sovereignty-is-all-you-need/:path*",
      "permanent": true
    },
    {
      "source": "/protocol/schema",
      "destination": "/ns/autonomaton/v1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ns/autonomaton/v1/context.jsonld",
      "headers": [
        { "key": "Content-Type", "value": "application/ld+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "has": [
        { "type": "host", "value": "registrar.the-grove.ai" }
      ],
      "destination": "/.well-known/$1"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "registrar.the-grove.ai" }
      ],
      "destination": "/registrar/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "registrar.the-grove.ai" }
      ],
      "destination": "/registrar/$1"
    },
    {
      "source": "/autonomaton/:path*",
      "destination": "https://grove-autonomaton-pattern.vercel.app/:path*"
    },
    {
      "source": "/autonomaton",
      "destination": "https://grove-autonomaton-pattern.vercel.app/"
    }
  ]
}
